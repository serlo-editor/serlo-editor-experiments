{
  "name": "serlo-editor-experiments",
  "private": true,
  "description": "Experiments for the Serlo Editor",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "pnpm run check:tsc && pnpm run check:format && pnpm run check:lint",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "check:tsc": "tsc --noEmit",
    "new": "node --experimental-strip-types scripts/create-experiment.ts",
    "fix": "pnpm run fix:format && pnpm run fix:lint && pnpm run check:tsc",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "26.7.0"
  },
  "packageManager": "pnpm@11.22.0"
}
