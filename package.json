{
  "name": "serlo-editor-experiments",
  "private": true,
  "description": "Experiments for the Serlo Editor",
  "license": "MIT",
  "workspaces": [
    "src/*"
  ],
  "type": "module",
  "scripts": {
    "build:pages": "bun scripts/build-github-pages.ts",
    "check": "bun run check:behavior && bun run check:format && bun run check:lint",
    "check:behavior": "bun run check:tsc && bun run test",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "check:tsc": "tsc --noEmit",
    "new": "bun scripts/create-experiment.ts",
    "fix": "bun run check:behavior && bun run fix:format && bun run fix:lint",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  }
}
