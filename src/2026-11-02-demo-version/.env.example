# Copy to `.env` (gitignored) and restart `bun run dev`.
# Only `PUBLIC_*` variables are inlined into the browser bundle (see bunfig.toml and `build`).

# Host of the sync server, without protocol. Unset: tabs of this browser sync via BroadcastChannel.
# PUBLIC_SYNC_HOST=serlo-editor-demo-sync.<your-subdomain>.workers.dev
# PUBLIC_SYNC_HOST=localhost:8787
