{
  "name": "2026-11-02-demo-version",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.html --outdir dist/ --env='PUBLIC_*'",
    "check": "bun run check:tsc && bun run test && bun run check:format && bun run check:lint",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "check:tsc": "tsc --noEmit && tsc --noEmit -p server",
    "fix": "bun run fix:lint && bun run fix:format && bun run check",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "dev": "bun --watch src/index.html",
    "format": "oxfmt",
    "preview": "bun run build && bun dist/index.html",
    "server:deploy": "wrangler deploy -c server/wrangler.jsonc",
    "server:dev": "wrangler dev -c server/wrangler.jsonc",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource/inclusive-sans": "5.3.0",
    "clsx": "2.1.1",
    "es-toolkit": "1.46.1",
    "lucide-react": "1.65.0",
    "partyserver": "0.5.10",
    "prosekit": "0.20.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "temml": "0.14.0",
    "y-partyserver": "2.2.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.30"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.6",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "7.0.2",
    "wrangler": "4.156.0"
  }
}
