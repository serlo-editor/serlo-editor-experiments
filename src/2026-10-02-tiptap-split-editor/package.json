{
  "name": "2026-10-02-tiptap-split-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "check": "pnpm run check:tsc && pnpm run check:format && pnpm run check:lint",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "check:tsc": "tsc --noEmit",
    "dev": "vite",
    "fix": "pnpm run fix:format && pnpm run fix:lint && pnpm run check:tsc",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "preview": "vite preview"
  },
