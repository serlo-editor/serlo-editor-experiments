    "autoprefixer": "^10.6.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
