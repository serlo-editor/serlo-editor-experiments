{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.html --outdir dist --minify",
    "check": "bun run check:tsc && bun run test && bun run check:format && bun run check:lint",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "check:tsc": "tsc --noEmit",
    "dev": "bun --watch src/index.html",
    "fix": "bun run fix:lint && bun run fix:format && bun run check",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "test": "bun test"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.75.0",
    "typescript": "~7.0.2"
  }
}
